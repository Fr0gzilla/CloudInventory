SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_PASSWORD=
# DATABASE_URL profiles:
#   Container (production): sqlite:////app/data/cloudinventory.db  (absolute path on named volume sqlite_data)
#   Local (development):    sqlite:///cloudinventory.db            (relative, resolved under Flask instance_path)
DATABASE_URL=sqlite:///cloudinventory.db

# Notifications : désactivées par défaut ; aucun envoi sans configuration explicite.
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=cloudinventory@localhost
# Destinataires séparés par des virgules.
SMTP_TO=
# URL HTTP(S) du webhook ; vide pour désactiver. Peut contenir un secret.
WEBHOOK_URL=

# Exports (RG24) : activé/désactivé, chemin de stockage, rétention
EXPORT_ENABLED=false
EXPORT_LOCAL_PATH=exports
# Chemin monté localement ou UNC //serveur/partage/dossier (prioritaire sur le local).
EXPORT_SMB_PATH=
EXPORT_SMB_USERNAME=
EXPORT_SMB_PASSWORD=
EXPORT_RETENTION_CONSOLIDATED=30
EXPORT_RETENTION_RAW=7
EXPORT_RAW_ENABLED=false

# Collectes réelles : HTTPS obligatoire ; TLS vérifié si option vide.
# APP_ENV vide/absent = production ; false réservé à local/development/test/testing.
APP_ENV=production
# Smoke HTTP isolé : SMOKE_PROFILE=test make smoke (venv installé).
# Ne lit pas .env : compte généré, SQLite temporaire, mocks, aucun service externe.
# Refus par défaut ; cette variable ne change jamais le profil de production.
SMOKE_PROFILE=
PROXMOX_CA_BUNDLE=
PROXMOX_VERIFY_SSL=
PROXMOX_URL=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
NETBOX_URL=
NETBOX_TOKEN=
NETBOX_VERIFY_SSL=
# Mettre true explicitement pour les mocks, false pour les API réelles.
USE_MOCK_IPAM=
USE_MOCK_VIRT=
# Budget collecte : 300 s partagées ; RUNNING expirés récupérés au run suivant.
# NetBox : 50 pages, 10 000 enregistrements, 1 MiB/page, 5 MiB au total.
# SMB : chiffrement exigé ; serveur incompatible refusé sans repli.

# Connexions web/API : fichier JSON hors modèle, verrou flock Linux, stdlib seule.
# Fenêtres fixes par clé, TTL non prolongé par un refus ; succès sans remise à zéro.
# Tous les workers doivent partager le même chemin sur disque LOCAL (pas NFS).
# Dossier existant privé et inscriptible ; fichiers 0600, remplacement atomique.
# En conteneur : RATE_LIMIT_STORE_PATH=/app/data/login-budgets.json sur volume persistant.
# Défaut : instance/login-budgets.json ; tests : chemin temporaire propre à chaque test.
# Panne/corruption/verrou occupé : 503 ; budget/capacité épuisé : 429 + Retry-After.
# IP = remote_addr uniquement ; X-Forwarded-For ignoré (aucun proxy approuvé).
# Corps login <=8192 octets ; utilisateur <=256 et mot de passe <=4096 octets UTF-8.
# Documentation Swagger privée : session web exigée, JWT métier inchangé.
RATE_LIMIT_IP_MAX=10
RATE_LIMIT_ACCOUNT_MAX=20
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_STORE_PATH=
# Cardinalité 3..10000 : éviction des expirés à chaque admission, jamais des actifs.
# Capacité atteinte : refus jusqu'à expiration ; lecture bornée à 2 Mo.
RATE_LIMIT_MAX_ENTRIES=10000
# Limites budgets : 1..100000 ; fenêtre : 1..86400 secondes.

# Sécurité : SECRET_KEY et JWT_SECRET_KEY doivent faire au moins 32 octets (256 bits).
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(32))"
