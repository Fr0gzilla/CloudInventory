# Replace all three placeholders locally before starting the application.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
ADMIN_PASSWORD=change-me

# Keep external providers disabled in local development.
USE_MOCK_VIRT=true
USE_MOCK_IPAM=true

# Local HTTP port for Compose; smoke starts its own HTTP server on a free loopback port.
APP_PORT=5050

# Compose uses sqlite:////app/data/cloudinventory.sqlite3 in its named volume.
# For local runs, omit DATABASE_URL to use the project's ignored data/ directory.

# Notifications are off unless enabled individually; simulated delivery is the default.
SMTP_ENABLED=false
USE_MOCK_SMTP=true
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_TO=
SMTP_USERNAME=
SMTP_PASSWORD=
WEBHOOK_ENABLED=false
USE_MOCK_WEBHOOK=true
WEBHOOK_URL=
